# Reddit API Credentials (Optional - keep empty if unauthorized)
# If provided, Reddit authorized API access will be enabled.
# Never commit your real credentials to version control.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RayBanTrustIntelligence/1.0

# Guardian is disabled pending licence clarification. These values do not enable it.
# Do not add placeholder permission references. .env is not loaded automatically.
GUARDIAN_API_KEY=
# Reference to applicable research permission covering analysis and retention.
GUARDIAN_PERMISSION_REFERENCE=
